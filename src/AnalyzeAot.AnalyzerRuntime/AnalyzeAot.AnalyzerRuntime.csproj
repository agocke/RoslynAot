<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>../../eng/Roslyn.Test.public.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);RSEXPERIMENTAL006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AnalyzeAot.Abi/AnalyzeAot.Abi.csproj" />
    <ProjectReference Include="../AnalyzeAot.GeneratedFacade.Runtime/AnalyzeAot.GeneratedFacade.Runtime.csproj" />
    <ProjectReference Include="../AnalyzeAot.GeneratedFacade/AnalyzeAot.GeneratedFacade.csproj" />
    <ProjectReference Include="../AnalyzeAot.GeneratedFacade.CSharp/AnalyzeAot.GeneratedFacade.CSharp.csproj" />
    <Compile Include="../AnalyzeAot.Generated/Projection/AnalyzerRuntime/**/*.cs"
             Link="Generated/Roslyn/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
