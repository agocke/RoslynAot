<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>AnalyzeAot.Experimental</PackageId>
    <Version>0.1.0</Version>
    <Description>Experimental NativeAOT compiler host and analyzer ABI.</Description>
    <Authors>AnalyzeAot contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <_PackageConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</_PackageConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AnalyzeAot.Abi/AnalyzeAot.Abi.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../AnalyzeAot.AnalyzerRuntime/AnalyzeAot.AnalyzerRuntime.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../AnalyzeAot.GeneratedFacade.Runtime/AnalyzeAot.GeneratedFacade.Runtime.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../AnalyzeAot.GeneratedFacade/AnalyzeAot.GeneratedFacade.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../AnalyzeAot.GeneratedFacade.CSharp/AnalyzeAot.GeneratedFacade.CSharp.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <None Include="buildTransitive/AnalyzeAot.Experimental.props"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="buildTransitive/AnalyzeAot.Experimental.targets"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="tools/compiler/AnalyzeAot.CompilerHost.csproj"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.CompilerHost/Program.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.CompilerHost/NativeDiagnosticAnalyzer.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.CompilerHost/AnalyzeAotCSharpCompiler.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.CompilerHost/RoslynHandleTable.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.CompilerHost/RoslynInterop.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.CompilerHost/RoslynProjectionValidation.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.Abi/AnalyzerAbi.cs"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../AnalyzeAot.Generated/Projection/Abi/**/*.cs"
          Pack="true"
          PackagePath="tools/compiler/Generated/Roslyn/Abi/" />
    <None Include="../AnalyzeAot.Generated/Projection/Compiler/**/*.cs"
          Pack="true"
          PackagePath="tools/compiler/Generated/Roslyn/Compiler/" />
    <None Include="../AnalyzeAot.Generated/Projection/Manifest/RoslynProjection.json"
          Pack="true"
          PackagePath="tools/compiler/Generated/Roslyn/Manifest/" />
    <None Include="../../eng/Roslyn.Test.public.snk"
          Pack="true"
          PackagePath="tools/compiler/" />
    <None Include="../../artifacts/bin/AnalyzeAot.Abi/$(_PackageConfiguration)/AnalyzeAot.Abi.dll"
          Pack="true"
          PackagePath="tools/analyzer-runtime/" />
    <None Include="../../artifacts/bin/AnalyzeAot.AnalyzerRuntime/$(_PackageConfiguration)/AnalyzeAot.AnalyzerRuntime.dll"
          Pack="true"
          PackagePath="tools/analyzer-runtime/" />
    <None Include="../../artifacts/bin/AnalyzeAot.GeneratedFacade.Runtime/$(_PackageConfiguration)/AnalyzeAot.GeneratedFacade.Runtime.dll"
          Pack="true"
          PackagePath="tools/analyzer-runtime/" />
    <None Include="../../artifacts/bin/AnalyzeAot.GeneratedFacade/$(_PackageConfiguration)/Microsoft.CodeAnalysis.dll"
          Pack="true"
          PackagePath="tools/analyzer-runtime/" />
    <None Include="../../artifacts/bin/AnalyzeAot.GeneratedFacade.CSharp/$(_PackageConfiguration)/Microsoft.CodeAnalysis.CSharp.dll"
          Pack="true"
          PackagePath="tools/analyzer-runtime/" />
    <None Include="../../README.md"
          Pack="true"
          PackagePath="/" />
  </ItemGroup>

</Project>
