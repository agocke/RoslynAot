<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>roslyn-aot-csharp-net-analyzers</AssemblyName>
    <TypeMapEntryAssembly>$(AssemblyName)</TypeMapEntryAssembly>
    <_SdkAnalyzerDirectory>$(MSBuildSDKsPath)/Microsoft.NET.Sdk/analyzers</_SdkAnalyzerDirectory>
    <_SdkRoslynDirectory>$(MSBuildSDKsPath)/../Roslyn/bincore</_SdkRoslynDirectory>
    <_AnalyzerAssembly>$(_SdkAnalyzerDirectory)/Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll</_AnalyzerAssembly>
    <_GeneratorConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</_GeneratorConfiguration>
    <_GeneratorPath>$(ArtifactsPath)/bin/RoslynAot.RoslynFacadeGenerator/$(_GeneratorConfiguration)/RoslynAot.RoslynFacadeGenerator.dll</_GeneratorPath>
    <_GeneratedEntryPoint>$(BaseIntermediateOutputPath)generated/AnalyzerEntryPoint.g.cs</_GeneratedEntryPoint>
  </PropertyGroup>

  <!--
    RoslynAotAnalyzers restricts the module to a semicolon-separated list of
    analyzer metadata names. Empty (the default) links every C# analyzer in the
    assembly. eng/measure-modules.sh sets it to build one module per analyzer
    for the per-analyzer size baseline.
  -->
  <ItemGroup>
    <_RoslynAotAnalyzer Include="$(RoslynAotAnalyzers)" />
  </ItemGroup>

  <PropertyGroup>
    <_AnalyzerFilterArguments>@(_RoslynAotAnalyzer->'--analyzer &quot;%(Identity)&quot;', ' ')</_AnalyzerFilterArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RoslynAot.AnalyzerRuntime/RoslynAot.AnalyzerRuntime.csproj" />
    <ProjectReference Include="../../tools/RoslynAot.RoslynFacadeGenerator/RoslynAot.RoslynFacadeGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;NativeLib" />
    <Reference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <HintPath>$(_SdkAnalyzerDirectory)/Microsoft.CodeAnalysis.NetAnalyzers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.NetAnalyzers">
      <HintPath>$(_AnalyzerAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="$(_GeneratedEntryPoint)" />
  </ItemGroup>

  <!--
    Deliberately not Inputs/Outputs incremental. Timestamp incrementality
    cannot see RoslynAotAnalyzers, so a build following a filtered one would
    reuse the previous filter's entry point and silently produce a module with
    the wrong analyzers in it. The generator writes only when the content
    changes, so running it every build costs one process and still leaves the
    compile incremental.
  -->
  <Target Name="GenerateAnalyzerEntryPoint"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences">
    <Exec Command="dotnet &quot;$(_GeneratorPath)&quot; generate-analyzer-entrypoint --output &quot;$(_GeneratedEntryPoint)&quot; --namespace &quot;RoslynAot.CSharpNetAnalyzers.Native&quot; --language &quot;C#&quot; --reference &quot;$(_SdkAnalyzerDirectory)&quot; --reference &quot;$(_SdkRoslynDirectory)&quot; $(_AnalyzerFilterArguments) &quot;$(_AnalyzerAssembly)&quot;" />
  </Target>

</Project>
